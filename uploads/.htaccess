# Les fichiers sont servis uniquement par les contrôleurs PHP après contrôle des droits.
# Bloquer tout accès HTTP direct, y compris les documents non exécutables.
Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
</IfModule>
